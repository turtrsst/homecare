APP_NAME="Soeradji Care"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Development default: SQLite (file database/database.sqlite).
# Produksi: MySQL/MariaDB — isi blok DB_* di bawah dan ubah DB_CONNECTION=mysql.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=homecare
DB_USERNAME=homecare
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# Gunakan "database" atau "redis" di produksi bila diinginkan; "file" adalah
# default portabel tanpa dependensi tambahan.
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="rsupsoeradji_klaten@yahoo.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_TIMEZONE=Asia/Jakarta

HOMECARE_HOSPITAL_NAME="RSUP Dr. Soeradji Tirtonegoro Klaten"
HOMECARE_EMERGENCY_NUMBER="119"
HOMECARE_CONTACT_PHONE="(0272) 321020"
HOMECARE_CONTACT_WA="(0272) 321020"
HOMECARE_CONTACT_EMAIL="rsupsoeradji_klaten@yahoo.com"
HOMECARE_CONTACT_ADDRESS="Jl. KRT. dr. Soeradji Tirtonegoro No. 1, Tegalyoso, Klaten Selatan, Klaten, Jawa Tengah 57424"
HOMECARE_WEBSITE="https://rsupsoeradji.id"
HOMECARE_MIN_LEAD_DAYS=1
HOMECARE_MAX_ADVANCE_DAYS=30

# Integrasi eksternal (local-first; lihat config/integrations.php)
INTEGRATION_PATIENT_PROVIDER=local
INTEGRATION_PAYMENT_PROVIDER=manual
INTEGRATION_MESSAGE_SENDER=log
INTEGRATION_MAPS_PROVIDER=null
